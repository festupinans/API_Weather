# URLs base de Open-Meteo (sin "/" final)
GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1
FORECAST_BASE_URL=https://api.open-meteo.com/v1

# Tiempo máximo de espera por cada llamada a Open-Meteo, en milisegundos
UPSTREAM_TIMEOUT_MS=5000

# Nivel mínimo de log: debug | info | warn | error
LOG_LEVEL=info
