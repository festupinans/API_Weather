{
  "name": "api-weather",
  "version": "1.0.0",
  "description": "API serverless (API Gateway + Lambda) que expone el clima actual de una ciudad usando Open-Meteo",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "serverless offline start",
    "package": "serverless package",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci": "npm run lint && npm run typecheck && npm run test:coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/festupinans/API_Weather.git"
  },
  "bugs": {
    "url": "https://github.com/festupinans/API_Weather/issues"
  },
  "homepage": "https://github.com/festupinans/API_Weather#readme",
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "serverless": "^3.40.0",
    "serverless-esbuild": "^1.57.2",
    "serverless-offline": "^13.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
